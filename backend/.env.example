APP_NAME=CareerCratly.AI
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Frontend origins (used when ENVIRONMENT is not development)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_BYTES=5242880
MAX_COURSES_PER_SKILL=3
MAX_JOBS=50
PRELOAD_EXTRACTOR=true

JOB_PROVIDER=mock
COURSE_PROVIDER=mock
PROJECT_PROVIDER=static

# LinkedIn Talent partner credentials — never commit real secrets.
# There is no public LinkedIn job-search API; Job Posting APIs are partner-only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202603
LINKEDIN_JOB_SEARCH_ENABLED=false

# Official Naukri feed/API only (not scraping).
NAUKRI_API_KEY=
NAUKRI_API_URL=
